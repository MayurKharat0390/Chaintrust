# ============================================================
# ChainTrust – Environment Variables (TEMPLATE)
# ============================================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── OpenRouter ────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Ollama (local) ────────────────────────────────────────────
# No key needed; set base URL if not using default
OLLAMA_BASE_URL=http://localhost:11434

# ── Blockchain / Web3 ─────────────────────────────────────────
# Private key for the account that deploys and writes anchors
# Use a throwaway dev account, NEVER a mainnet wallet
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Address of deployed ChainTrust contract (filled after deployment)
CONTRACT_ADDRESS=

# Sepolia RPC (only needed if network=sepolia in config.yaml)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ── Optional overrides ────────────────────────────────────────
# DATABASE_URL=sqlite:///custom_path.db
# LOG_LEVEL=DEBUG
